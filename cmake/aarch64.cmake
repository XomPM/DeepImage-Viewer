set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED TC)
  set(TC $ENV{LLVM_MINGW}) # path to an llvm-mingw toolchain
endif()
set(CMAKE_C_COMPILER ${TC}/bin/aarch64-w64-mingw32-clang)
set(CMAKE_CXX_COMPILER ${TC}/bin/aarch64-w64-mingw32-clang++)
set(CMAKE_RC_COMPILER ${TC}/bin/aarch64-w64-mingw32-windres)
set(CMAKE_AR ${TC}/bin/llvm-ar)
set(CMAKE_RANLIB ${TC}/bin/llvm-ranlib)
set(CMAKE_FIND_ROOT_PATH ${TC}/aarch64-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(CMAKE_C_FLAGS_INIT "-ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "-ffunction-sections -fdata-sections")
